# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_API_TOKEN=replace-with-a-random-secret
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
# Qwen instruct mode avoids returning hidden reasoning before the JSON object.
GROQ_REASONING_EFFORT=none
# Optional trusted UTF-8 files. Invalid explicit files fail before paid API calls.
# ANALYSIS_PROMPT_FILE=/app/config/analysis_prompt.txt
# CONFERENCE_CONFIG_FILE=/app/config/conferences.json
GITHUB_TOKEN=replace-with-a-fine-grained-token
GITHUB_REPO=owner/repository
# REDIS_URL=redis://redis:6379/0
# For an existing no-Redis single-service deployment this defaults to true.
# Redis always disables legacy mode to prevent duplicate schedulers.
# ENABLE_LEGACY_MODE=false
WEB_CONCURRENCY=2
UVICORN_LIMIT_CONCURRENCY=200
PIPELINE_TIMEOUT_SECONDS=1200
PIPELINE_LOCK_TTL_SECONDS=1800
JOB_LEASE_SECONDS=1800
JOB_MAX_ATTEMPTS=3
API_RATE_LIMIT=300
MCP_RATE_LIMIT=30
LOCAL_RATE_LIMIT_MAX_KEYS=10000
MAX_ARXIV_RESPONSE_BYTES=16777216
TRUSTED_PROXY_CIDRS=172.16.0.0/12
