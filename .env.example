# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_API_TOKEN=replace-with-a-random-secret
GROQ_API_KEY=replace-with-your-groq-key
GITHUB_TOKEN=replace-with-a-fine-grained-token
GITHUB_REPO=owner/repository
# REDIS_URL=redis://redis:6379/0
# For an existing no-Redis single-service deployment this defaults to true.
# Redis always disables legacy mode to prevent duplicate schedulers.
# ENABLE_LEGACY_MODE=false
WEB_CONCURRENCY=2
UVICORN_LIMIT_CONCURRENCY=200
PIPELINE_TIMEOUT_SECONDS=1200
PIPELINE_LOCK_TTL_SECONDS=1800
JOB_LEASE_SECONDS=1800
JOB_MAX_ATTEMPTS=3
API_RATE_LIMIT=300
MCP_RATE_LIMIT=30
TRUSTED_PROXY_CIDRS=172.16.0.0/12
